{
  "name": "orca-phpantom",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-editor.ts",
    "test": "orca plugin test .",
    "test:property": "node --test \"tests/property/*.property.ts\"",
