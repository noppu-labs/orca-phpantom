    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "@types/node": "24.19.4",
    "esbuild": "0.28.2",
    "fast-check": "^4.11.0",
    "monaco-editor": "0.58.0",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2009",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.3"
  }
}
