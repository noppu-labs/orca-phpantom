{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "execution": "trusted-worker",
  "id": "phpantom",
  "name": "PHP, Laravel, Symfony, WP",
  "version": "0.3.0",
  "description": "Errors as you type, completion, go to definition and quick fixes for PHP. Understands Laravel, Symfony, WordPress, Drupal, Yii 3, Tempest, PHPUnit and Pest with nothing to switch on. Powered by PHPantom.",
  "license": "MIT",
  "repository": "https://github.com/noppu-labs/orca-phpantom",
  "engines": { "orca": ">=1.4.259" },
  "pluginApi": 1,
  "main": "src/main.ts",
  "capabilities": [
    { "kind": "settings:own" },
    { "kind": "workspace:read" },
    { "kind": "workspace:write" }
  ],
  "contributes": {
    "customEditors": [
      {
        "id": "blade",
        "title": "PHPantom",
        "extensions": [".blade.php"],
        "entry": "editor/pages/blade.html",
        "priority": "default",
        "frame": "isolated"
      },
      {
        "id": "php",
        "title": "PHPantom",
        "extensions": [".php", ".module", ".install", ".theme", ".profile", ".inc", ".engine"],
        "entry": "editor/pages/php.html",
        "priority": "default",
        "frame": "isolated"
      }
    ],
    "settings": [
      {
        "key": "phpantomPath",
        "title": "PHPantom binary",
        "description": "Full path to phpantom_lsp. Leave empty to find it on PATH or download it.",
        "type": "string",
        "default": "",
        "placeholder": "/opt/homebrew/bin/phpantom_lsp"
      },
      {
        "key": "allowDownload",
        "title": "Download PHPantom when missing",
        "description": "Fetch the pinned PHPantom release from GitHub and check its SHA-256 when none is installed.",
        "type": "boolean",
        "default": true
      }
    ],
    "commands": [
      { "id": "phpantom.status", "title": "PHPantom: Show status" },
      { "id": "phpantom.restart", "title": "PHPantom: Restart language servers" }
    ],
    "statusBarItems": [
      {
        "id": "phpantom",
        "text": "PHPantom",
        "icon": "code",
        "tone": "neutral",
        "tooltip": "PHPantom",
        "command": "phpantom.status"
      }
    ]
  }
}
